Smallest

#include <iostream>
#include <limits.h>
using namespace std;

int main() {
    int arr[] = {6,4,6,8,9};
    int size = 5;
    
    int smallest = INT_MAX;
    int smallestIndex = -1;
    
    for(int i = 0; i<size; i++){
        if(arr[i]<smallest){
            smallest = arr[i];
            smallestIndex = i;
        }
    }
    cout << "Smallest=" << smallest << endl;
    return 0;
}

