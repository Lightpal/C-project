#include <iostream>
using namespace std;

int LinearSearch(int arr[], int sz, int target){
    for(int i = 0; i<sz; i++){
        if(arr[i]==target){
            return i;
        }
    }
    return -1;
}
int main() {
   int arr[] = {2,4,6,8,4,2,7,8};
   int sz = 8;
   int target = 8;
   
   cout << LinearSearch(arr,sz,target) << endl;
    return 0;
}
